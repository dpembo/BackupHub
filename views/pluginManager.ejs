<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0"/>
  <title>Orchelium | Plugin Manager</title>
  <%- include('./partials/_head'); %>
</head>
<body>
<%- include('./partials/_header'); %>

<div class="container" style="margin-top:24px;">

  <!-- Header row -->
  <div class="row" style="margin-bottom:0">
    <div class="col s12 m8">
      <h5 class="header orange-text">Plugin Manager</h5>
    </div>
    <div class="col s12 m4" style="text-align:right;padding-top:14px;">
      <a id="updateAllBtn" class="btn-flat waves-effect waves-light orange-text" onclick="updateAllPlugins()" title="Update all plugins with available updates" style="display:none;">
        <span class="material-icons" style="vertical-align:middle;">update</span> Update All
      </a>
      <a id="refreshBtn" class="btn-flat waves-effect waves-light orange-text" onclick="loadRegistry()">
        <span class="material-icons" style="vertical-align:middle;">refresh</span> Refresh
      </a>
    </div>
  </div>

  <!-- Security notice -->
  <div class="card-panel plugin-security-notice" style="margin-bottom:16px; border-left:4px solid #ef6c00;">
    <span class="orange-text text-darken-3">
      <span class="material-icons tiny" style="vertical-align:middle;">security</span>
      <strong>Security notice:</strong> Plugins execute shell scripts on your connected agents.
      Only install plugins from sources you trust. Review plugin files before installing.
    </span>
  </div>

  <div class="row">
    <!-- Left sidebar: filters -->
    <div class="col s12 m3 l3">
      <ul id="categoryList" class="plugin-filter-list" style="list-style:none;padding:0;margin:0;border-radius:4px;">
        <li class="cat-item active" data-category="">
          <span class="cat-item-inner">
            <span class="material-icons tiny">apps</span>
            <span>All Plugins</span>
          </span>
          <span class="cat-badge cat-badge-orange" id="badgeAll"></span>
        </li>
        <li class="cat-item" data-category="installed">
          <span class="cat-item-inner">
            <span class="material-icons tiny">check_circle</span>
            <span>Installed</span>
          </span>
          <span class="cat-badge cat-badge-green" id="badgeInstalled" style="display:none"></span>
        </li>
        <li class="cat-item" data-category="update">
          <span class="cat-item-inner">
            <span class="material-icons tiny">update</span>
            <span>Updates</span>
          </span>
          <span class="cat-badge cat-badge-deep-orange" id="badgeUpdates" style="display:none"></span>
        </li>
        <li class="cat-item" data-category="not-installed">
          <span class="cat-item-inner">
            <span class="material-icons tiny">download</span>
            <span>Not Installed</span>
          </span>
          <span class="cat-badge cat-badge-grey" id="badgeNotInstalled"></span>
        </li>
        <li class="plugin-filter-divider"></li>
        <!-- Category items injected by JS -->
      </ul>
    </div>

    <!-- Main content: search + plugin cards -->
    <div class="col s12 m9 l9">
      <!-- Search -->
      <div class="row" style="margin-bottom:12px;">
        <div class="col s12">
          <div class="input-field" style="margin-top:0;">
            <span class="material-icons prefix" style="top:8px;">search</span>
            <input type="text" id="pluginSearch" placeholder="Search plugins…" oninput="renderPlugins()">
          </div>
        </div>
      </div>

      <!-- Loading indicator -->
      <div id="loadingIndicator" style="text-align:center; padding:40px;">
        <div class="preloader-wrapper active" style="width:40px;height:40px;">
          <div class="spinner-layer spinner-orange-only">
            <div class="circle-clipper left"><div class="circle"></div></div>
            <div class="gap-patch"><div class="circle"></div></div>
            <div class="circle-clipper right"><div class="circle"></div></div>
          </div>
        </div>
        <p class="grey-text">Loading plugin registry…</p>
      </div>

      <!-- Error state -->
      <div id="errorState" style="display:none;" class="card-panel red lighten-5">
        <span class="red-text">
          <span class="material-icons tiny" style="vertical-align:middle;">error</span>
          <span id="errorMessage">Could not load plugin registry.</span>
        </span>
      </div>

      <!-- Plugin grid -->
      <div id="pluginGrid" class="row" style="display:none;"></div>

      <!-- Empty filtered state -->
      <div id="emptyState" style="display:none; text-align:center; padding:40px;">
        <span class="material-icons large grey-text">extension_off</span>
        <p class="grey-text">No plugins match your filter.</p>
      </div>
    </div>
  </div>

</div>

<!-- Confirm uninstall modal -->
<div id="uninstallModal" class="modal">
  <div class="modal-content">
    <h5>Uninstall Plugin</h5>
    <p>Are you sure you want to uninstall <strong id="uninstallPluginLabel"></strong>?
       Any orchestrations using this plugin will stop working.</p>
  </div>
  <div class="modal-footer">
    <a href="#!" class="modal-close btn-flat">Cancel</a>
    <a id="confirmUninstallBtn" href="#!" class="btn red waves-effect waves-light">Uninstall</a>
  </div>
</div>

<%- include('./partials/_footer'); %>
<%- include('./partials/_scripts'); %>

<style>
  /* ── Sidebar cat-items ─────────────────────────────────────── */
  .cat-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 0.88rem;
  }
  .cat-item:hover { background: #fff3e0; }
  .cat-item.active { background: #fff3e0; font-weight: 600; color: #e65100; }
  .cat-item.active .material-icons { color: #e65100; }
  .cat-item-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
  }
  .cat-item-inner span:not(.material-icons) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cat-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    margin-left: 6px;
  }
  .cat-badge-orange     { background: #ef6c00; }
  .cat-badge-green      { background: #43a047; }
  .cat-badge-deep-orange { background: #e64a19; }
  .cat-badge-grey       { background: #9e9e9e; }
</style>

<script>
  // ── Data ──────────────────────────────────────────────────────────────────
  let _allPlugins        = [];
  let _activeCategory    = '';   // '' = all, 'installed', 'update', or a category name
  let _pendingUninstall  = null; // { name, label }

  const CATEGORY_ICONS = {
    backup:      'backup',
    databases:   'storage',
    'file-sync': 'sync',
    storage:     'dns',
    containers:  'layers',
    system:      'settings',
  };

  // ── Bootstrap ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    M.Modal.init(document.querySelectorAll('.modal'));
    loadRegistry();
  });

  // ── Fetch registry from server ────────────────────────────────────────────
  async function loadRegistry() {
    document.getElementById('loadingIndicator').style.display = 'block';
    document.getElementById('errorState').style.display       = 'none';
    document.getElementById('pluginGrid').style.display       = 'none';
    document.getElementById('emptyState').style.display       = 'none';

    try {
      const resp = await fetch('/rest/plugins/registry', { credentials: 'same-origin' });
      if (!resp.ok) {
        const body = await resp.json().catch(() => ({}));
        throw new Error(body.message || `HTTP ${resp.status}`);
      }
      const data = await resp.json();
      _allPlugins = data.plugins || [];
      buildCategoryList();
      renderPlugins();
    } catch (err) {
      document.getElementById('errorMessage').textContent =
        'Could not load plugin registry: ' + err.message;
      document.getElementById('errorState').style.display = 'block';
    } finally {
      document.getElementById('loadingIndicator').style.display = 'none';
    }
  }

  // ── Build category sidebar ─────────────────────────────────────────────────
  function buildCategoryList() {
    const categories = [...new Set(_allPlugins.map(p => p.category).filter(Boolean))].sort();
    const list       = document.getElementById('categoryList');

    // Remove previously injected category items
    list.querySelectorAll('[data-injected]').forEach(el => el.remove());

    categories.forEach(cat => {
      const li = document.createElement('li');
      li.className = 'cat-item';
      li.dataset.category = cat;
      li.dataset.injected = '1';
      const icon  = CATEGORY_ICONS[cat] || 'extension';
      const count = _allPlugins.filter(p => p.category === cat).length;
      li.innerHTML =
        `<span class="cat-item-inner">` +
          `<span class="material-icons tiny">${icon}</span>` +
          `<span>${titleCase(cat)}</span>` +
        `</span>` +
        `<span class="cat-badge cat-badge-grey">${count}</span>`;
      li.addEventListener('click', () => setCategory(cat));
      list.appendChild(li);
    });

    // Update badge counts
    const installed    = _allPlugins.filter(p => p.installed).length;
    const updates      = _allPlugins.filter(p => p.updateAvailable).length;
    const notInstalled = _allPlugins.filter(p => !p.installed).length;

    document.getElementById('badgeAll').textContent          = _allPlugins.length;
    document.getElementById('badgeInstalled').textContent    = installed;
    document.getElementById('badgeUpdates').textContent      = updates;
    document.getElementById('badgeNotInstalled').textContent = notInstalled;
    document.getElementById('badgeInstalled').style.display    = installed ? '' : 'none';
    document.getElementById('badgeUpdates').style.display      = updates   ? '' : 'none';
    document.getElementById('updateAllBtn').style.display      = updates   ? '' : 'none';

    // Re-attach click handlers for static items
    document.querySelectorAll('#categoryList .cat-item').forEach(el => {
      el.onclick = () => setCategory(el.dataset.category);
    });

    document.getElementById('pluginGrid').style.display = 'flex';
  }

  function setCategory(cat) {
    _activeCategory = cat;
    document.querySelectorAll('#categoryList .cat-item').forEach(el => {
      el.classList.toggle('active', el.dataset.category === cat);
    });
    renderPlugins();
  }

  // ── Render plugin cards ────────────────────────────────────────────────────
  function renderPlugins() {
    const query  = (document.getElementById('pluginSearch').value || '').toLowerCase();
    const grid   = document.getElementById('pluginGrid');

    let filtered = _allPlugins;
    if (_activeCategory === 'installed')     filtered = filtered.filter(p => p.installed);
    else if (_activeCategory === 'update')        filtered = filtered.filter(p => p.updateAvailable);
    else if (_activeCategory === 'not-installed') filtered = filtered.filter(p => !p.installed);
    else if (_activeCategory) filtered = filtered.filter(p => p.category === _activeCategory);

    if (query) {
      filtered = filtered.filter(p =>
        p.label.toLowerCase().includes(query) ||
        (p.description || '').toLowerCase().includes(query) ||
        (p.tags || []).some(t => t.toLowerCase().includes(query))
      );
    }

    grid.innerHTML = '';

    if (filtered.length === 0) {
      document.getElementById('pluginGrid').style.display  = 'none';
      document.getElementById('emptyState').style.display  = 'block';
      return;
    }

    document.getElementById('emptyState').style.display  = 'none';
    document.getElementById('pluginGrid').style.display  = 'flex';
    grid.style.flexWrap = 'wrap';

    filtered.forEach(plugin => {
      const col = document.createElement('div');
      col.className = 'col s12 m6 l4';

      const statusBadge = plugin.updateAvailable
        ? `<span class="badge new deep-orange lighten-1" data-badge-caption="">Update</span>`
        : plugin.installed
          ? `<span class="badge new green" data-badge-caption="">Installed</span>`
          : '';

      const iconEl  = plugin.iconUrl
        ? `<img src="${escAttr(plugin.iconUrl)}" width="32" height="32" style="margin-right:10px;flex-shrink:0;border-radius:4px;" alt="" onerror="pluginIconError(this,'${escAttr(plugin.category)}')">`
        : `<span class="material-icons orange-text" style="font-size:2rem;margin-right:10px;">${CATEGORY_ICONS[plugin.category] || 'extension'}</span>`;
      const tags    = (plugin.tags || []).map(t =>
        `<span class="chip" style="height:20px;font-size:11px;line-height:20px;margin:2px 2px 0 0;">${escHtml(t)}</span>`
      ).join('');

      const actionBtn = buildActionButton(plugin);
      const docsClick = plugin.docsUrl
        ? `onclick="window.open('${escAttr(plugin.docsUrl)}','_blank','noopener')" title="View documentation" style="flex:1; padding:16px; cursor:pointer;"`
        : `style="flex:1; padding:16px;"`;

      col.innerHTML = `
        <div class="card hoverable" style="min-height:200px; display:flex; flex-direction:column;">
          <div class="card-content" ${docsClick}>
            <div style="display:flex; align-items:center; margin-bottom:8px;">
              ${iconEl}
              <div style="flex:1">
                <span style="font-size:1rem;font-weight:600;line-height:1.2;display:block;">${escHtml(plugin.label)}</span>
                <div style="font-size:0.75rem;color:#888;">v${escHtml(plugin.version || '—')}</div>
              </div>
              <div>${statusBadge}</div>
            </div>
            <p class="plugin-card-desc" style="font-size:0.85rem;margin:0 0 8px 0;">${escHtml(plugin.description || '')}</p>
            <div>${tags}</div>
          </div>
          <div class="card-action" style="padding:8px 16px;">
            ${actionBtn}
          </div>
        </div>`;
      grid.appendChild(col);
    });
  }

  function buildActionButton(plugin) {
    if (plugin.updateAvailable) {
      return `
        <a class="btn-small waves-effect waves-light deep-orange" onclick="installPlugin('${escAttr(plugin.name)}', this)" title="Update to v${escAttr(plugin.version)}">
          <span class="material-icons tiny" style="vertical-align:middle;">update</span> Update
        </a>
        <a class="btn-small btn-flat waves-effect red-text" onclick="promptUninstall('${escAttr(plugin.name)}','${escAttr(plugin.label)}')" title="Uninstall">
          <span class="material-icons tiny" style="vertical-align:middle;">delete</span>
        </a>`;
    }
    if (plugin.installed) {
      return `
        <span class="green-text" style="font-size:0.85rem;vertical-align:middle;">
          <span class="material-icons tiny" style="vertical-align:middle;">check_circle</span> Installed
        </span>
        <a class="btn-small btn-flat waves-effect red-text" style="float:right;" onclick="promptUninstall('${escAttr(plugin.name)}','${escAttr(plugin.label)}')" title="Uninstall">
          <span class="material-icons tiny" style="vertical-align:middle;">delete</span> Uninstall
        </a>`;
    }
    return `
      <a class="btn-small waves-effect waves-light orange" onclick="installPlugin('${escAttr(plugin.name)}', this)">
        <span class="material-icons tiny" style="vertical-align:middle;">download</span> Install
      </a>`;
  }

  // ── Install ────────────────────────────────────────────────────────────────
  async function installPlugin(pluginName, triggerEl) {
    const plugin = _allPlugins.find(p => p.name === pluginName);
    if (!plugin) return;

    triggerEl.classList.add('disabled');
    triggerEl.textContent = 'Installing…';

    try {
      const resp = await fetch(`/rest/plugins/install/${encodeURIComponent(pluginName)}`, {
        method:      'POST',
        credentials: 'same-origin',
        headers:     { 'Content-Type': 'application/json' },
        body:        JSON.stringify({ registryEntry: plugin }),
      });
      const body = await resp.json();
      if (!resp.ok) throw new Error(body.message || `HTTP ${resp.status}`);

      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">check_circle</span> ${plugin.label} installed`, classes: 'green' });
      await loadRegistry();
    } catch (err) {
      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">error</span> Install failed: ${err.message}`, classes: 'red', displayLength: 6000 });
      triggerEl.classList.remove('disabled');
      triggerEl.innerHTML = '<span class="material-icons tiny" style="vertical-align:middle;">download</span> Install';
    }
  }

  // ── Update All ─────────────────────────────────────────────────────────────
  async function updateAllPlugins() {
    const pluginsToUpdate = _allPlugins.filter(p => p.updateAvailable);
    if (pluginsToUpdate.length === 0) {
      M.toast({ html: 'No plugin updates available', classes: 'grey' });
      return;
    }

    const updateAllBtn = document.getElementById('updateAllBtn');
    updateAllBtn.classList.add('disabled');
    const originalHtml = updateAllBtn.innerHTML;
    updateAllBtn.innerHTML = '<span class="material-icons" style="vertical-align:middle;">hourglass_empty</span> Updating…';

    let successCount = 0;
    let failCount = 0;
    const errors = [];

    for (const plugin of pluginsToUpdate) {
      try {
        const resp = await fetch(`/rest/plugins/install/${encodeURIComponent(plugin.name)}`, {
          method:      'POST',
          credentials: 'same-origin',
          headers:     { 'Content-Type': 'application/json' },
          body:        JSON.stringify({ registryEntry: plugin }),
        });
        const body = await resp.json();
        if (!resp.ok) throw new Error(body.message || `HTTP ${resp.status}`);
        successCount++;
      } catch (err) {
        failCount++;
        errors.push(`${plugin.label}: ${err.message}`);
      }
    }

    // Reload registry after all updates
    await loadRegistry();

    // Show summary
    if (failCount === 0) {
      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">check_circle</span> ${successCount} plugin${successCount !== 1 ? 's' : ''} updated`, classes: 'green' });
    } else {
      const msg = `${successCount} updated, ${failCount} failed`;
      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">warning</span> ${msg}`, classes: 'orange darken-1', displayLength: 6000 });
      if (errors.length > 0) {
        console.warn('Plugin update errors:', errors);
      }
    }

    updateAllBtn.classList.remove('disabled');
    updateAllBtn.innerHTML = originalHtml;
  }

  // ── Uninstall ──────────────────────────────────────────────────────────────
  function promptUninstall(pluginName, pluginLabel) {
    _pendingUninstall = { name: pluginName, label: pluginLabel };
    document.getElementById('uninstallPluginLabel').textContent = pluginLabel;
    document.getElementById('confirmUninstallBtn').onclick = () => doUninstall(pluginName, pluginLabel);
    M.Modal.getInstance(document.getElementById('uninstallModal')).open();
  }

  async function doUninstall(pluginName, pluginLabel) {
    M.Modal.getInstance(document.getElementById('uninstallModal')).close();
    try {
      const resp = await fetch(`/rest/plugins/${encodeURIComponent(pluginName)}`, {
        method:      'DELETE',
        credentials: 'same-origin',
      });
      const body = await resp.json();
      if (!resp.ok) throw new Error(body.message || `HTTP ${resp.status}`);

      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">check_circle</span> ${pluginLabel} uninstalled`, classes: 'orange darken-1' });
      await loadRegistry();
    } catch (err) {
      M.toast({ html: `<span class="material-icons tiny" style="vertical-align:middle;margin-right:6px;">error</span> Uninstall failed: ${err.message}`, classes: 'red', displayLength: 6000 });
    }
  }

  // ── Utilities ──────────────────────────────────────────────────────────────
  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escAttr(str) {
    return String(str).replace(/'/g, '&#39;').replace(/"/g, '&quot;');
  }

  function pluginIconError(el, category) {
    const icon = CATEGORY_ICONS[category] || 'extension';
    const span = document.createElement('span');
    span.className = 'material-icons orange-text';
    span.style.cssText = 'font-size:2rem;margin-right:10px;';
    span.textContent = icon;
    el.parentNode.replaceChild(span, el);
  }

  function titleCase(str) {
    return str.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  }
</script>

</body>
</html>
